<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sovereign Speaker Intelligent Adaptive Matrix</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        sovereign: {
                            bg: '#010308',
                            panel: 'rgba(5, 10, 22, 0.85)',
                            border: 'rgba(30, 41, 59, 0.7)',
                            cyan: '#06b6d4',
                            emerald: '#10b981',
                            amber: '#f59e0b',
                            purple: '#8b5cf6'
                        }
                    }
                }
            }
        }
    </script>
    <!-- Google Fonts Inter & JetBrains Mono -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;600;800&display=swap" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Three.js for 3D Graphics -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <!-- Tone.js for Audio Synthesis -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/tone/14.8.49/Tone.js"></script>
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #010308;
            color: #f8fafc;
            overflow: hidden;
            margin: 0;
            padding: 0;
            width: 100vw;
            height: 100vh;
        }
        .mono {
            font-family: 'JetBrains Mono', monospace;
        }
        .glass-panel {
            background: rgba(5, 10, 22, 0.85);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
            border: 1px solid rgba(30, 41, 59, 0.7);
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.6);
        }
        canvas {
            display: block;
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 1;
        }
        .ui-layer {
            position: relative;
            z-index: 10;
            pointer-events: none;
        }
        .interactive {
            pointer-events: auto;
        }
        /* Adaptive Window transitions */
        .adaptive-window {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .adaptive-window.minimized {
            height: 48px !important;
            overflow: hidden;
        }
    </style>
</head>
<body class="w-screen h-screen overflow-hidden flex flex-col justify-between selection:bg-cyan-500 selection:text-white">

    <!-- Three.js Canvas Container for Instant Zero-Latency Touch / Mouse Reaction -->
    <div id="canvas-container" class="absolute inset-0 w-full h-full cursor-grab active:cursor-grabbing"></div>

    <!-- Top Navigation / Telemetry Header -->
    <header class="ui-layer w-full p-4 md:p-6 flex items-center justify-between pointer-events-none">
        <div class="glass-panel interactive px-5 py-3 rounded-2xl flex items-center space-x-3 border-cyan-500/30">
            <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-cyan-500 to-blue-600 flex items-center justify-center shadow-lg shadow-cyan-500/30 animate-pulse">
                <i class="fa-solid fa-atom text-white text-sm"></i>
            </div>
            <div>
                <h1 class="font-bold text-sm tracking-wider text-white">SOVEREIGN <span class="text-cyan-400">SPEAKER MATRIX</span></h1>
                <p class="text-[10px] text-slate-400 mono">INSTANT ZERO-LATENCY TOUCH v6.4</p>
            </div>
        </div>

        <!-- Adaptive Telemetry HUD Banner -->
        <div class="hidden lg:flex glass-panel interactive px-6 py-2.5 rounded-2xl items-center space-x-6 mono text-xs">
            <div>
                <span class="text-slate-500 block text-[9px]">RESPONSE LATENCY</span>
                <span id="telemetry-latency" class="text-emerald-400 font-bold">&lt; 0.4 ms</span>
            </div>
            <div class="h-6 w-px bg-slate-800"></div>
            <div>
                <span class="text-slate-500 block text-[9px]">ADAPTIVE GAIN STAGE</span>
                <span id="telemetry-gainstage" class="text-cyan-400 font-bold">OPTIMIZED</span>
            </div>
            <div class="h-6 w-px bg-slate-800"></div>
            <div>
                <span class="text-slate-500 block text-[9px]">HARMONIC COHERENCE</span>
                <span id="telemetry-coherence" class="text-amber-400 font-bold">99.99%</span>
            </div>
        </div>

        <!-- Master Audio Engine Toggle -->
        <div class="interactive">
            <button id="master-audio-btn" onclick="toggleMasterAudio()" class="glass-panel px-5 py-3 rounded-2xl flex items-center space-x-2.5 bg-cyan-950/40 hover:bg-cyan-900/50 text-cyan-300 border-cyan-500/40 text-xs font-semibold transition-all shadow-xl shadow-cyan-500/10">
                <i class="fa-solid fa-volume-xmark text-cyan-400" id="master-audio-icon"></i>
                <span id="master-audio-text">Enable Speaker Engine</span>
            </button>
        </div>
    </header>

    <!-- Floating Adaptive System Windows (Draggable / Collapsible) -->
    <main class="ui-layer absolute top-20 right-4 md:right-6 w-80 md:w-96 flex flex-col space-y-4 pointer-events-none">
        
        <!-- Window 1: Intelligent Acoustic Analyzer -->
        <div id="window-analyzer" class="glass-panel adaptive-window interactive rounded-2xl p-4 shadow-2xl border-cyan-500/20">
            <div class="flex items-center justify-between pb-3 border-b border-slate-800">
                <div class="flex items-center space-x-2 text-xs font-bold text-slate-200">
                    <i class="fa-solid fa-chart-line text-cyan-400"></i>
                    <span>Intelligent Adaptive Analyzer</span>
                </div>
                <div class="flex items-center space-x-2">
                    <button onclick="toggleWindow('window-analyzer')" class="text-slate-400 hover:text-white transition-all text-xs" title="Minimize">
                        <i class="fa-solid fa-window-minimize"></i>
                    </button>
                </div>
            </div>
            
            <div class="pt-3 space-y-3">
                <div class="flex justify-between text-xs mono">
                    <span class="text-slate-400">Adaptive Profile:</span>
                    <span id="adaptive-profile-label" class="text-cyan-400 font-bold">DEEP SUB-BASS RESONANCE</span>
                </div>
                <!-- Real-time frequency spectrum visualizer bars -->
                <div class="flex items-end justify-between h-16 bg-slate-950/80 p-2 rounded-xl border border-slate-800/80" id="live-spectrum-bars">
                    <div class="w-2.5 bg-cyan-500 rounded-t h-4 transition-all duration-75"></div>
                    <div class="w-2.5 bg-cyan-400 rounded-t h-8 transition-all duration-75"></div>
                    <div class="w-2.5 bg-blue-500 rounded-t h-12 transition-all duration-75"></div>
                    <div class="w-2.5 bg-emerald-500 rounded-t h-6 transition-all duration-75"></div>
                    <div class="w-2.5 bg-amber-500 rounded-t h-14 transition-all duration-75"></div>
                    <div class="w-2.5 bg-cyan-400 rounded-t h-10 transition-all duration-75"></div>
                    <div class="w-2.5 bg-purple-500 rounded-t h-7 transition-all duration-75"></div>
                    <div class="w-2.5 bg-cyan-500 rounded-t h-11 transition-all duration-75"></div>
                </div>
            </div>
        </div>

        <!-- Window 2: Instant Touch Reaction & Harmonic Staging -->
        <div id="window-staging" class="glass-panel adaptive-window interactive rounded-2xl p-4 shadow-2xl border-purple-500/20">
            <div class="flex items-center justify-between pb-3 border-b border-slate-800">
                <div class="flex items-center space-x-2 text-xs font-bold text-slate-200">
                    <i class="fa-solid fa-bolt text-purple-400"></i>
                    <span>Instant Touch & Gain Staging</span>
                </div>
                <div class="flex items-center space-x-2">
                    <button onclick="toggleWindow('window-staging')" class="text-slate-400 hover:text-white transition-all text-xs" title="Minimize">
                        <i class="fa-solid fa-window-minimize"></i>
                    </button>
                </div>
            </div>

            <div class="pt-3 space-y-3">
                <div class="space-y-1">
                    <div class="flex justify-between text-xs">
                        <span class="text-slate-400">Woofer Base Frequency</span>
                        <span id="freq-val" class="text-cyan-400 mono font-bold">55 Hz</span>
                    </div>
                    <input type="range" id="freq-slider" min="30" max="250" step="1" value="55" oninput="updateFrequency(this.value)"
                           class="w-full accent-cyan-500 bg-slate-900 h-2 rounded-lg cursor-pointer">
                </div>

                <div class="space-y-1">
                    <div class="flex justify-between text-xs">
                        <span class="text-slate-400">High-Gain Overdrive Staging</span>
                        <span id="gain-val" class="text-purple-400 mono font-bold">35%</span>
                    </div>
                    <input type="range" id="gain-slider" min="0" max="100" step="1" value="35" oninput="updateGainStaging(this.value)"
                           class="w-full accent-purple-500 bg-slate-900 h-2 rounded-lg cursor-pointer">
                </div>
            </div>
        </div>

    </main>

    <!-- Bottom Center Floating Action Bar for Instant Impulses -->
    <footer class="ui-layer w-full p-4 md:p-6 flex items-center justify-center pointer-events-none">
        <div class="glass-panel interactive px-6 py-3 rounded-2xl flex items-center space-x-4 shadow-2xl border-cyan-500/30">
            <button onclick="triggerInstantShockwave()" class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-white font-bold text-xs shadow-lg shadow-cyan-500/30 transition-all flex items-center space-x-2">
                <i class="fa-solid fa-wave-square"></i>
                <span>TRIGGER INSTANT SHOCKWAVE</span>
            </button>
            <div class="h-6 w-px bg-slate-800"></div>
            <button onclick="resetAdaptiveMatrix()" class="px-4 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold text-xs transition-all border border-slate-700">
                <i class="fa-solid fa-rotate-right mr-1"></i> Reset Matrix
            </button>
        </div>
    </footer>

    <!-- JavaScript Application Logic -->
    <script>
        // --- Application State ---
        let audioActive = false;
        let baseFrequency = 55;
        let gainStaging = 0.35;
        let touchShockwaveIntensity = 0.0;
        let lastTouchTime = 0;

        // Tone.js Synth & FX Chain
        let synth = null;
        let distortion = null;
        let filter = null;
        let analyser = null;

        // Three.js State
        let scene, camera, renderer;
        let speakerGroup, wooferCone, dustCap;
        let particleSystem, particleGeometry, particlePositions;
        let shockwaveRings = [];
        let clock = new THREE.Clock();

        // Mouse / Touch Interaction State for Instant Response
        let isPointerDown = false;
        let pointerPosition = { x: 0, y: 0 };
        let targetRotation = { x: 0, y: 0 };
        let currentRotation = { x: 0, y: 0 };

        // Initialize on Window Load
        window.onload = function() {
            initThreeJS();
            initInstantTouchListeners();
            startAnimationLoop();
        };

        // --- Three.js 3D Setup ---
        function initThreeJS() {
            const container = document.getElementById('canvas-container');

            scene = new THREE.Scene();
            scene.fog = new THREE.FogExp2(0x010308, 0.025);

            camera = new THREE.PerspectiveCamera(55, window.innerWidth / window.innerHeight, 0.1, 1000);
            camera.position.set(0, 1.5, 11);
            camera.lookAt(0, 0, 0);

            renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
            renderer.setSize(window.innerWidth, window.innerHeight);
            renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
            container.appendChild(renderer.domElement);

            // Lighting
            const ambientLight = new THREE.AmbientLight(0xffffff, 0.6);
            scene.add(ambientLight);

            const cyanLight = new THREE.PointLight(0x06b6d4, 3, 35);
            cyanLight.position.set(0, 6, 8);
            scene.add(cyanLight);

            const purpleLight = new THREE.PointLight(0x8b5cf6, 2.5, 35);
            purpleLight.position.set(0, -6, -6);
            scene.add(purpleLight);

            // Build Speaker Group
            speakerGroup = new THREE.Group();
            scene.add(speakerGroup);

            // Baffle
            const baffleGeo = new THREE.BoxGeometry(8.5, 8.5, 1.2);
            const baffleMat = new THREE.MeshStandardMaterial({ color: 0x070b16, roughness: 0.25, metalness: 0.95 });
            const baffle = new THREE.Mesh(baffleGeo, baffleMat);
            baffle.position.z = -0.6;
            speakerGroup.add(baffle);

            // Woofer Cone
            const coneGeo = new THREE.ConeGeometry(3.4, 2.0, 64, 16, true);
            const coneMat = new THREE.MeshStandardMaterial({ color: 0x0f172a, roughness: 0.4, metalness: 0.8, side: THREE.DoubleSide });
            wooferCone = new THREE.Mesh(coneGeo, coneMat);
            wooferCone.rotation.x = Math.PI / 2;
            wooferCone.position.z = 0.2;
            speakerGroup.add(wooferCone);

            // Center Dust Cap (Adaptive Glowing Core)
            const capGeo = new THREE.SphereGeometry(1.1, 32, 32, 0, Math.PI * 2, 0, Math.PI / 2);
            const capMat = new THREE.MeshStandardMaterial({ color: 0x06b6d4, emissive: 0x06b6d4, emissiveIntensity: 0.7, roughness: 0.2, metalness: 0.9 });
            dustCap = new THREE.Mesh(capGeo, capMat);
            dustCap.rotation.x = Math.PI;
            dustCap.position.z = -0.4;
            speakerGroup.add(dustCap);

            // Surround Ring
            const ringGeo = new THREE.TorusGeometry(3.4, 0.32, 24, 64);
            const ringMat = new THREE.MeshStandardMaterial({ color: 0x02040a, roughness: 0.9, metalness: 0.1 });
            const surround = new THREE.Mesh(ringGeo, ringMat);
            surround.position.z = 0.8;
            speakerGroup.add(surround);

            // Particle System
            const particleCount = 700;
            particleGeometry = new THREE.BufferGeometry();
            particlePositions = new Float32Array(particleCount * 3);

            for (let i = 0; i < particleCount * 3; i += 3) {
                const angle = Math.random() * Math.PI * 2;
                const radius = 4.2 + Math.random() * 5.5;
                particlePositions[i] = Math.cos(angle) * radius;
                particlePositions[i+1] = (Math.random() - 0.5) * 7;
                particlePositions[i+2] = Math.sin(angle) * radius;
            }

            particleGeometry.setAttribute('position', new THREE.BufferAttribute(particlePositions, 3));
            const particleMaterial = new THREE.PointsMaterial({ color: 0x06b6d4, size: 0.13, transparent: true, opacity: 0.75 });
            particleSystem = new THREE.Points(particleGeometry, particleMaterial);
            scene.add(particleSystem);

            window.addEventListener('resize', () => {
                camera.aspect = window.innerWidth / window.innerHeight;
                camera.updateProjectionMatrix();
                renderer.setSize(window.innerWidth, window.innerHeight);
            });
        }

        // --- Instant Zero-Latency Touch & Mouse Interaction ---
        function initInstantTouchListeners() {
            const container = document.getElementById('canvas-container');

            const handlePointerDown = (clientX, clientY) => {
                isPointerDown = true;
                pointerPosition = { x: clientX, y: clientY };
                
                // Instant zero-latency impulse reaction
                const startTime = performance.now();
                triggerInstantShockwave();
                const latency = (performance.now() - startTime).toFixed(2);
                document.getElementById('telemetry-latency').textContent = `< ${Math.max(0.1, latency)} ms`;
            };

            const handlePointerMove = (clientX, clientY) => {
                if (!isPointerDown) return;
                const deltaX = clientX - pointerPosition.x;
                const deltaY = clientY - pointerPosition.y;

                targetRotation.y += deltaX * 0.004;
                targetRotation.x += deltaY * 0.004;
                targetRotation.x = Math.max(-Math.PI / 4, Math.min(Math.PI / 4, targetRotation.x));

                pointerPosition = { x: clientX, y: clientY };
            };

            const handlePointerUp = () => { isPointerDown = false; };

            // Mouse Events
            container.addEventListener('mousedown', (e) => {
                if (e.target.closest('.interactive')) return;
                handlePointerDown(e.clientX, e.clientY);
            });
            window.addEventListener('mousemove', (e) => handlePointerMove(e.clientX, e.clientY));
            window.addEventListener('mouseup', handlePointerUp);

            // Touch Events (Zero-latency mobile support)
            container.addEventListener('touchstart', (e) => {
                if (e.target.closest('.interactive') || e.touches.length !== 1) return;
                handlePointerDown(e.touches[0].clientX, e.touches[0].clientY);
            }, { passive: true });

            window.addEventListener('touchmove', (e) => {
                if (!isPointerDown || e.touches.length !== 1) return;
                handlePointerMove(e.touches[0].clientX, e.touches[0].clientY);
            }, { passive: true });

            window.addEventListener('touchend', handlePointerUp);
        }

        // --- Web Audio API & Intelligent Adaptive Engine ---
        function toggleMasterAudio() {
            const btnText = document.getElementById('master-audio-text');
            const icon = document.getElementById('master-audio-icon');
            const btn = document.getElementById('master-audio-btn');

            if (!audioActive) {
                Tone.start();

                distortion = new Tone.Distortion(gainStaging * 0.6).toDestination();
                filter = new Tone.Filter(1400, "lowpass").connect(distortion);
                analyser = new Tone.Analyser("fft", 64);
                filter.connect(analyser);

                synth = new Tone.Synth({
                    oscillator: { type: "sine" },
                    envelope: { attack: 0.02, decay: 0.15, sustain: 0.85, release: 0.5 }
                }).connect(filter);

                synth.volume.value = Tone.gainToDb(0.75);
                synth.triggerAttack(baseFrequency);

                audioActive = true;
                btnText.textContent = "Disable Speaker Engine";
                icon.className = "fa-solid fa-volume-high text-cyan-400";
                btn.className = "glass-panel px-5 py-3 rounded-2xl flex items-center space-x-2.5 bg-cyan-600/30 hover:bg-cyan-600/50 text-cyan-200 border-cyan-500/50 text-xs font-semibold transition-all shadow-xl shadow-cyan-500/20";
                document.getElementById('telemetry-gainstage').textContent = "ACTIVE (ADAPTIVE)";
            } else {
                if (synth) {
                    synth.triggerRelease();
                    synth.dispose();
                    synth = null;
                }
                audioActive = false;
                btnText.textContent = "Enable Speaker Engine";
                icon.className = "fa-solid fa-volume-xmark text-cyan-400";
                btn.className = "glass-panel px-5 py-3 rounded-2xl flex items-center space-x-2.5 bg-cyan-950/40 hover:bg-cyan-900/50 text-cyan-300 border-cyan-500/30 text-xs font-semibold transition-all shadow-xl shadow-cyan-500/10";
                document.getElementById('telemetry-gainstage').textContent = "STANDBY";
            }
        }

        function updateFrequency(val) {
            baseFrequency = parseFloat(val);
            document.getElementById('freq-val').textContent = baseFrequency + " Hz";
            if (synth && audioActive) {
                synth.frequency.setValueAtTime(baseFrequency, Tone.now());
            }

            // Intelligent Adaptive Profile Updating
            const profileLabel = document.getElementById('adaptive-profile-label');
            if (baseFrequency < 60) {
                profileLabel.textContent = "DEEP SUB-BASS RESONANCE";
            } else if (baseFrequency < 120) {
                profileLabel.textContent = "PUNCHY MID-BASS HARMONIC";
            } else {
                profileLabel.textContent = "HIGH-FREQUENCY TRANSIENT";
            }
        }

        function updateGainStaging(val) {
            gainStaging = parseFloat(val) / 100;
            document.getElementById('gain-val').textContent = val + "%";
            if (distortion) {
                distortion.distortion = gainStaging * 0.8;
            }
        }

        function triggerInstantShockwave() {
            touchShockwaveIntensity = 1.0;

            if (synth && audioActive) {
                synth.triggerAttackRelease(baseFrequency * 1.6, "16n");
            } else {
                Tone.start().then(() => {
                    const tempSynth = new Tone.Synth().toDestination();
                    tempSynth.triggerAttackRelease(baseFrequency, "32n");
                });
            }

            // Spawn Shockwave Ring
            const ringGeo = new THREE.RingGeometry(0.4, 0.7, 32);
            const ringMat = new THREE.MeshBasicMaterial({ color: 0x06b6d4, side: THREE.DoubleSide, transparent: true, opacity: 0.95 });
            const shockRing = new THREE.Mesh(ringGeo, ringMat);
            shockRing.position.z = 0.9;
            scene.add(shockRing);
            shockwaveRings.push({ mesh: shockRing, scale: 1, opacity: 0.95 });
        }

        function resetAdaptiveMatrix() {
            updateFrequency(55);
            document.getElementById('freq-slider').value = 55;
            updateGainStaging(35);
            document.getElementById('gain-slider').value = 35;
        }

        function toggleWindow(windowId) {
            const win = document.getElementById(windowId);
            win.classList.toggle('minimized');
        }

        // --- Main Animation & Render Loop ---
        function startAnimationLoop() {
            renderer.setAnimationLoop(() => {
                const elapsedTime = clock.getElapsedTime();

                // Smooth rotation damping
                currentRotation.x += (targetRotation.x - currentRotation.x) * 0.08;
                currentRotation.y += (targetRotation.y - currentRotation.y) * 0.08;

                if (speakerGroup) {
                    speakerGroup.rotation.x = currentRotation.x;
                    speakerGroup.rotation.y = currentRotation.y;
                }

                // Instant Woofer vibration physics
                const vibSpeed = baseFrequency * 0.22;
                const vibAmp = (baseFrequency / 250) * 0.35 + (touchShockwaveIntensity * 0.85);
                const currentVib = Math.sin(elapsedTime * vibSpeed) * vibAmp;

                if (wooferCone) {
                    wooferCone.position.z = 0.2 + currentVib;
                    wooferCone.scale.set(1 + currentVib * 0.12, 1 + currentVib * 0.12, 1);
                }

                if (dustCap) {
                    dustCap.position.z = -0.4 + currentVib * 1.4;
                    dustCap.material.emissiveIntensity = 0.5 + Math.abs(currentVib) * 3.0 + (touchShockwaveIntensity * 2.0);
                }

                // Decay shockwave
                if (touchShockwaveIntensity > 0) {
                    touchShockwaveIntensity -= 0.04;
                    if (touchShockwaveIntensity < 0) touchShockwaveIntensity = 0;
                }

                // Animate Shockwave rings
                for (let i = shockwaveRings.length - 1; i >= 0; i--) {
                    const ring = shockwaveRings[i];
                    ring.scale += 0.3;
                    ring.opacity -= 0.05;
                    ring.mesh.scale.set(ring.scale, ring.scale, ring.scale);
                    ring.mesh.material.opacity = ring.opacity;

                    if (ring.opacity <= 0) {
                        scene.remove(ring.mesh);
                        ring.mesh.geometry.dispose();
                        ring.mesh.material.dispose();
                        shockwaveRings.splice(i, 1);
                    }
                }

                // Particle orbit
                if (particleSystem) {
                    particleSystem.rotation.y = elapsedTime * 0.12;
                }

                // Update Spectrum Analyzer UI bars
                if (audioActive && analyser) {
                    const values = analyser.getValue();
                    const bars = document.getElementById('live-spectrum-bars').children;
                    for (let i = 0; i < bars.length; i++) {
                        const val = Math.abs(values[i * 2] || -100);
                        const heightPct = Math.min(100, Math.max(15, (val + 100) * 1.25));
                        bars[i].style.height = heightPct + '%';
                    }
                } else {
                    const bars = document.getElementById('live-spectrum-bars').children;
                    for (let i = 0; i < bars.length; i++) {
                        const heightPct = 25 + Math.sin(elapsedTime * 6 + i) * 40;
                        bars[i].style.height = heightPct + '%';
                    }
                }

                renderer.render(scene, camera);
            });
        }
    </script>
</body>
</html>
